---
import PostMeta from "@/components/PostMeta.astro"

interface Props {
  author: string
  date: Date
  readTime: number
}

const { author, date, readTime } = Astro.props
---

<div class="flex items-center gap-3">
  <div
    class="grid size-10 place-items-center rounded-full bg-muted"
    aria-hidden="true"
  >
    <span class="size-4 rounded-full bg-slate-400"></span>
  </div>
  <div>
    <p class="text-sm font-semibold">By {author}</p>
    <PostMeta date={date} readTime={readTime} />
  </div>
</div>
