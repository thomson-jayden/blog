---
import { Menu } from "lucide-react"
import PageContainer from "@/components/PageContainer.astro"
import SiteLogo from "@/components/SiteLogo.astro"
import { withBase } from "@/lib/site"

interface Props {
  active?: "home" | "blog" | "about"
}

const { active } = Astro.props
const links = [
  { label: "Home", href: withBase("/"), key: "home" },
  { label: "Blog", href: withBase("/posts"), key: "blog" },
  { label: "About", href: withBase("/about"), key: "about" },
]
---

<!-- TODO: Add site search once the search experience and indexing strategy are ready. -->
<header class="border-b bg-background/95">
  <PageContainer>
    <div class="relative flex h-18 items-center justify-between">
      <SiteLogo />

      <nav
        class="hidden items-center gap-8 text-sm sm:flex"
        aria-label="Primary navigation"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={[
                "transition-colors hover:text-foreground",
                active === link.key
                  ? "font-semibold text-foreground"
                  : "text-muted-foreground",
              ]}
              aria-current={active === link.key ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <details class="group sm:hidden">
        <summary
          class="flex cursor-pointer list-none rounded-md p-1.5"
          aria-label="Open navigation menu"
        >
          <Menu size={22} />
        </summary>
        <nav
          class="absolute top-14 right-0 z-20 flex min-w-40 flex-col rounded-lg border bg-background p-2 text-sm shadow-lg"
          aria-label="Mobile navigation"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class:list={[
                  "rounded-md px-3 py-2 hover:bg-muted",
                  active === link.key && "font-semibold",
                ]}
                aria-current={active === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </PageContainer>
</header>
