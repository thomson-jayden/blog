---
import { Code2, Mail } from "lucide-react"
---

<div
  class="mt-6 flex items-center gap-4 text-muted-foreground"
  aria-label="Social links"
>
  <a href="#" class="rounded-md p-1 hover:text-foreground" aria-label="GitHub">
    <Code2 size={18} />
  </a>
  <a
    href="#"
    class="rounded-md p-1 hover:text-foreground"
    aria-label="LinkedIn"
  >
    <span class="text-sm font-bold">in</span>
  </a>
  <a
    href="#"
    class="rounded-md p-1 text-sm font-semibold hover:text-foreground"
    aria-label="X"
  >
    X
  </a>
  <a
    href="#"
    class="rounded-md p-1 hover:text-foreground"
    aria-label="Instagram"
  >
    <span class="text-base">◎</span>
  </a>
  <a
    href="mailto:hello@example.com"
    class="rounded-md p-1 hover:text-foreground"
    aria-label="Email"
  >
    <Mail size={18} />
  </a>
</div>
