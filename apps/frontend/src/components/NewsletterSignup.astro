<!-- TODO(#4): Connect this component to a newsletter provider before rendering it on a page. -->
<section class="rounded-2xl bg-muted px-6 py-10 text-center sm:px-10">
  <p class="eyebrow">Stay updated</p>
  <h2 class="mt-2 text-2xl font-semibold tracking-tight">
    Get new posts in your inbox
  </h2>
  <p class="mt-2 text-sm text-muted-foreground">
    A short sentence about the newsletter and what readers will get.
  </p>
  <form
    class="mx-auto mt-6 flex max-w-lg flex-col gap-3 sm:flex-row"
    aria-label="Newsletter signup"
  >
    <label for="newsletter-email" class="sr-only">Email address</label>
    <input
      id="newsletter-email"
      type="email"
      placeholder="Enter your email"
      class="h-11 min-w-0 flex-1 rounded-lg border bg-background px-4 text-sm"
    />
    <button
      type="button"
      class="h-11 rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground"
    >
      Subscribe
    </button>
  </form>
</section>
