---
import { ArrowRight } from "lucide-react"
import PageContainer from "@/components/PageContainer.astro"
import PostImage from "@/components/PostImage.astro"
import { withBase } from "@/lib/site"
---

<section id="about" class="py-16 sm:py-24">
  <PageContainer>
    <div class="grid items-center gap-12 md:grid-cols-[1.15fr_0.85fr]">
      <div>
        <p class="eyebrow">Thoughts, ideas, and projects</p>
        <h1
          class="mt-5 max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
        >
          A blog about tech, travel and everything in between.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-muted-foreground">
          Longer thoughts about the things I build, the places I visit, and the
          ideas I keep returning to.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={withBase("/posts")}
            class="inline-flex h-11 items-center gap-2 rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary/85"
          >
            Read the latest <ArrowRight size={16} />
          </a>
          <a
            href={withBase("/about")}
            class="inline-flex h-11 items-center rounded-lg border px-5 text-sm font-medium hover:bg-muted"
          >
            About me
          </a>
        </div>
      </div>
      <div
        class="mx-auto aspect-[4/5] w-full max-w-sm overflow-hidden rounded-xl"
      >
        <PostImage
          alt="Abstract landscape representing stories from the blog"
          class="object-cover"
        />
      </div>
    </div>
  </PageContainer>
</section>
