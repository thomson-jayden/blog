---
import { Link, Mail } from "lucide-react"
---

<div class="flex items-center gap-1" aria-label="Share this post">
  <button
    type="button"
    class="rounded-lg p-2 hover:bg-muted"
    aria-label="Copy post link"><Link size={17} /></button
  >
  <button
    type="button"
    class="rounded-lg p-2 text-sm font-semibold hover:bg-muted"
    aria-label="Share on X">X</button
  >
  <button
    type="button"
    class="rounded-lg p-2 text-sm font-bold hover:bg-muted"
    aria-label="Share on LinkedIn">in</button
  >
  <button
    type="button"
    class="rounded-lg p-2 hover:bg-muted"
    aria-label="Share by email"><Mail size={17} /></button
  >
</div>
