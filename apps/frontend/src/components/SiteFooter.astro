---
import PageContainer from "@/components/PageContainer.astro"
import SiteLogo from "@/components/SiteLogo.astro"
import { withBase } from "@/lib/site"
---

<!-- TODO: Add GitHub and RSS links once their destinations and feed are ready. -->
<footer class="border-t py-8">
  <PageContainer>
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <SiteLogo size="footer" />
        <p class="mt-2 text-sm text-muted-foreground">
          Thoughts, ideas, and projects.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-5 text-sm">
        <a
          href={withBase("/")}
          class="text-muted-foreground hover:text-foreground">Home</a
        >
        <a
          href={withBase("/posts")}
          class="text-muted-foreground hover:text-foreground">Blog</a
        >
        <a
          href={withBase("/about")}
          class="text-muted-foreground hover:text-foreground">About</a
        >
      </div>
    </div>
  </PageContainer>
</footer>
