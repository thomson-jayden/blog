---
import { getCollection } from "astro:content"
import CategoryFilters from "@/components/CategoryFilters.astro"
import PageContainer from "@/components/PageContainer.astro"
import Pagination from "@/components/Pagination.astro"
import PostCard from "@/components/PostCard.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import Layout from "@/layouts/main.astro"

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)
const categories = [...new Set(posts.map((post) => post.data.category))]
---

<Layout
  title="Posts — BlogName"
  description="Browse every article from BlogName."
>
  <SiteHeader active="blog" />
  <main class="py-14 sm:py-20">
    <PageContainer>
      <div class="mx-auto max-w-4xl">
        <p class="eyebrow">Blog</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
          All posts
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-muted-foreground">
          A collection of thoughts, tutorials, and experiences on tech, travel,
          projects, and life.
        </p>

        <div class="mt-8">
          <CategoryFilters categories={categories} />
        </div>

        <p
          class="mt-7 text-sm text-muted-foreground"
          aria-live="polite"
          data-results-summary
        >
        </p>
        <div class="mt-2 divide-y" data-post-list>
          {
            posts.map((post) => (
              <div class="py-7" data-post-wrapper>
                <PostCard post={post} variant="horizontal" />
              </div>
            ))
          }
        </div>
        <p
          class="hidden py-16 text-center text-muted-foreground"
          data-empty-state
        >
          No posts found in this category.
        </p>
        <Pagination />
      </div>
    </PageContainer>
  </main>
  <SiteFooter />

  <script>
    const pageSize = 4
    const filterRoot = document.querySelector("[data-category-filters]")
    const postWrappers = Array.from(
      document.querySelectorAll("[data-post-wrapper]")
    )
    const previousButton = document.querySelector("[data-page-previous]")
    const nextButton = document.querySelector("[data-page-next]")
    const pageNumbers = document.querySelector("[data-page-numbers]")
    const pagination = document.querySelector("[data-pagination]")
    const emptyState = document.querySelector("[data-empty-state]")
    const summary = document.querySelector("[data-results-summary]")

    const params = new URLSearchParams(window.location.search)
    let activeCategory = params.get("category") ?? "All"
    let activePage = Math.max(1, Number(params.get("page")) || 1)

    function updateUrl() {
      const nextParams = new URLSearchParams()
      if (activeCategory !== "All") nextParams.set("category", activeCategory)
      if (activePage > 1) nextParams.set("page", String(activePage))
      const query = nextParams.toString()
      window.history.replaceState(
        {},
        "",
        `${window.location.pathname}${query ? `?${query}` : ""}`
      )
    }

    function render() {
      const matchingPosts = postWrappers.filter(
        (wrapper) =>
          activeCategory === "All" ||
          wrapper
            .querySelector("[data-post-item]")
            ?.getAttribute("data-category") === activeCategory
      )
      const pageCount = Math.max(1, Math.ceil(matchingPosts.length / pageSize))
      activePage = Math.min(activePage, pageCount)

      postWrappers.forEach((wrapper) => wrapper.classList.add("hidden"))
      matchingPosts
        .slice((activePage - 1) * pageSize, activePage * pageSize)
        .forEach((wrapper) => wrapper.classList.remove("hidden"))

      filterRoot?.querySelectorAll("[data-category]").forEach((button) => {
        const selected = button.getAttribute("data-category") === activeCategory
        button.setAttribute("aria-pressed", String(selected))
        button.classList.toggle("bg-primary", selected)
        button.classList.toggle("text-primary-foreground", selected)
        button.classList.toggle("border-primary", selected)
      })

      if (pageNumbers) {
        pageNumbers.replaceChildren()
        for (let page = 1; page <= pageCount; page += 1) {
          const button = document.createElement("button")
          button.type = "button"
          button.textContent = String(page)
          button.className = "size-9 rounded-lg border text-sm"
          button.setAttribute("aria-label", `Page ${page}`)
          if (page === activePage) {
            button.classList.add(
              "bg-primary",
              "text-primary-foreground",
              "border-primary"
            )
            button.setAttribute("aria-current", "page")
          }
          button.addEventListener("click", () => {
            activePage = page
            render()
            document
              .querySelector("[data-post-list]")
              ?.scrollIntoView({ behavior: "smooth" })
          })
          pageNumbers.append(button)
        }
      }

      if (previousButton instanceof HTMLButtonElement) {
        previousButton.disabled = activePage === 1
      }
      if (nextButton instanceof HTMLButtonElement) {
        nextButton.disabled = activePage === pageCount
      }
      pagination?.classList.toggle("hidden", matchingPosts.length === 0)
      emptyState?.classList.toggle("hidden", matchingPosts.length !== 0)
      if (summary) {
        summary.textContent = `${matchingPosts.length} ${matchingPosts.length === 1 ? "post" : "posts"}`
      }
      updateUrl()
    }

    filterRoot?.addEventListener("click", (event) => {
      const target = event.target
      if (!(target instanceof Element)) return
      const button = target.closest("[data-category]")
      const category = button?.getAttribute("data-category")
      if (!category) return
      activeCategory = category
      activePage = 1
      render()
    })

    previousButton?.addEventListener("click", () => {
      if (activePage > 1) {
        activePage -= 1
        render()
      }
    })

    nextButton?.addEventListener("click", () => {
      activePage += 1
      render()
    })

    if (
      activeCategory !== "All" &&
      !filterRoot?.querySelector(
        `[data-category="${CSS.escape(activeCategory)}"]`
      )
    ) {
      activeCategory = "All"
    }
    render()
  </script>
</Layout>
