---
import { getCollection } from "astro:content"
import HeroSection from "@/components/HeroSection.astro"
import PageContainer from "@/components/PageContainer.astro"
import PostCard from "@/components/PostCard.astro"
import PostGrid from "@/components/PostGrid.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import Layout from "@/layouts/main.astro"
import { withBase } from "@/lib/site"

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0]
const recentPosts = posts
  .filter((post) => post.id !== featuredPost.id)
  .slice(0, 3)
---

<Layout title="BlogName — Thoughts, ideas, and projects">
  <SiteHeader active="home" />
  <main>
    <HeroSection />
    <PageContainer>
      <section class="border-y py-14 sm:py-18">
        <SectionHeader title="Featured post" href={withBase("/posts")} />
        <PostCard post={featuredPost} variant="featured" />
      </section>

      <section class="py-14 sm:py-18">
        <SectionHeader title="Recent posts" href={withBase("/posts")} />
        <PostGrid>
          {recentPosts.map((post) => <PostCard post={post} />)}
        </PostGrid>
      </section>
    </PageContainer>
  </main>
  <SiteFooter />
</Layout>
