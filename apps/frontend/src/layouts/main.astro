---
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "BlogName",
  description = "Thoughts, ideas, and projects about tech, travel, and everything in between.",
} = Astro.props
const faviconUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
